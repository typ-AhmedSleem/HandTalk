<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorParent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorParent"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_to_left"
        app:navigationIconTint="@color/colorPrimary"
        app:title="@string/arabic_to_sign_translator"
        app:titleCentered="true"
        app:titleTextColor="@color/colorPrimary" />

    <com.typ.handtalk.ui.a2s.views.A2SPlayablePlayerView
        android:id="@+id/a2s_translation_player_view"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_margin="25dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_a2s_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="10dp"
        app:boxBackgroundColor="@color/transparent"
        android:hint="@string/prompt_a2s"
        android:textAlignment="viewStart"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="@dimen/defaultButtonCornerRadius"
        app:boxCornerRadiusBottomStart="@dimen/defaultButtonCornerRadius"
        app:boxCornerRadiusTopEnd="@dimen/defaultButtonCornerRadius"
        app:boxCornerRadiusTopStart="@dimen/defaultButtonCornerRadius"
        app:expandedHintEnabled="true"
        app:layout_constraintBottom_toTopOf="@id/btn_translate_a2s"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="start"
            android:maxLength="100"
            android:inputType="text"
            android:textAlignment="viewStart"
            android:textColor="@color/colorTextTitle" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_translate_a2s"
        style="@style/DefaultMaterialButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/defaultButtonHeight"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="50dp"
        android:importantForAccessibility="no"
        android:layout_marginBottom="25dp"
        app:backgroundTint="@color/colorPrimary"
        android:text="@string/translate"
        app:cornerRadius="@dimen/defaultButtonCornerRadius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:rippleColor="@color/rippleForColorPrimary"
        app:tint="@color/colorOnPrimary" />

</androidx.constraintlayout.widget.ConstraintLayout>