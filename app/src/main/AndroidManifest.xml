<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:dist="http://schemas.android.com/apk/distribution"
    android:installLocation="preferExternal">

    <!-- Enable instant app support -->
    <dist:module dist:instant="true" />

    <!-- Features -->
    <uses-feature android:name="android.hardware.camera" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.HandTalk.HomeActivity"
        tools:targetApi="tiramisu">

        <activity
            android:name=".ui.activities.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.s2a.LiveSignTranslatorActivity"
            android:theme="@style/Theme.HandTalk"
            android:exported="true" />

        <activity
            android:name=".ui.a2s.Arabic2SignTranslationHistoryActivity"
            android:exported="true" />

        <activity
            android:name=".ui.a2s.Arabic2SignTranslatorActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true" />

        <activity
            android:name="com.typ.handtalk.ui.articles.ArticlesHubActivity"
            android:exported="true" />

        <activity
            android:name="com.typ.handtalk.ui.articles.ArticlesActivity"
            android:exported="true" />

        <activity
            android:name="com.typ.handtalk.ui.articles.ArticleViewerActivity"
            android:exported="true"
            android:theme="@style/Theme.Articles.TopicViewer" />

        <activity
            android:name="com.typ.handtalk.ui.articles.FoundationsActivity"
            android:exported="true" />

        <activity
            android:name="com.typ.handtalk.ui.articles.TranslatorsActivity"
            android:exported="true" />

        <activity
            android:name="com.typ.handtalk.ui.activities.RequestPermissionsActivity"
            android:exported="true" />

    </application>

</manifest>